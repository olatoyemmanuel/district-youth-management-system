// DYMS persistence models are implemented incrementally against the owner-approved CPERD-02 baseline.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserAccount {
  id                     String               @id @db.Uuid
  loginIdentifier        String               @unique(map: "uq_user_accounts_login_identifier") @map("login_identifier") @db.Text
  email                  String?              @db.Text
  phoneE164              String?              @map("phone_e164") @db.VarChar(20)
  passwordHash           String               @map("password_hash") @db.Text
  status                 String               @db.VarChar(24)
  emailVerifiedAt        DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt        DateTime?            @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt            DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime             @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @map("updated_at") @db.Timestamptz(6)
  authSessions           AuthSession[]
  passwordResetTokens    PasswordResetToken[]
  actorAuditEvents       AuditEvent[]         @relation("AuditActor")
  initiatedAuditEvents   AuditEvent[]         @relation("AuditInitiator")

  @@map("user_accounts")
}

model AuthSession {
  id                  String             @id @db.Uuid
  userAccountId       String             @map("user_account_id") @db.Uuid
  createdAt           DateTime           @map("created_at") @db.Timestamptz(6)
  lastActivityAt      DateTime           @map("last_activity_at") @db.Timestamptz(6)
  inactivityExpiresAt DateTime           @map("inactivity_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt   DateTime           @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt           DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revocationReason    String?            @map("revocation_reason") @db.Text
  userAgentSummary    String?            @map("user_agent_summary") @db.Text
  ipAddress           Unsupported("inet")? @map("ip_address")
  userAccount         UserAccount        @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_sessions_user_account_id")
  tokens              AuthSessionToken[]

  @@unique([id, userAccountId], map: "uq_auth_sessions_id_user_account")
  @@index([userAccountId, absoluteExpiresAt], map: "ix_auth_sessions_account_expiry")
  @@map("auth_sessions")
}

model AuthSessionToken {
  id              String      @id @db.Uuid
  authSessionId   String      @map("auth_session_id") @db.Uuid
  tokenHash       String      @unique(map: "uq_auth_session_tokens_token_hash") @map("token_hash") @db.Text
  tokenGeneration Int         @map("token_generation")
  issuedAt        DateTime    @map("issued_at") @db.Timestamptz(6)
  consumedAt      DateTime?   @map("consumed_at") @db.Timestamptz(6)
  revokedAt       DateTime?   @map("revoked_at") @db.Timestamptz(6)
  authSession     AuthSession @relation(fields: [authSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_session_tokens_auth_session_id")

  @@index([authSessionId, tokenGeneration(sort: Desc)], map: "ix_auth_session_tokens_session_generation")
  @@map("auth_session_tokens")
}

model PasswordResetToken {
  id            String      @id @db.Uuid
  userAccountId String      @map("user_account_id") @db.Uuid
  tokenHash     String      @map("token_hash") @db.Text
  createdAt     DateTime    @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime?   @map("consumed_at") @db.Timestamptz(6)
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_password_reset_tokens_user_account_id")

  @@index([userAccountId, expiresAt], map: "ix_password_reset_tokens_account_expiry")
  @@map("password_reset_tokens")
}

model PreAuthContext {
  id             String    @id @db.Uuid
  secretDigest   Bytes?    @map("secret_digest") @db.ByteA
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  secretErasedAt DateTime? @map("secret_erased_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "ix_pre_auth_contexts_expiry")
  @@map("pre_auth_contexts")
}

model AuditEvent {
  id                       String       @id @db.Uuid
  districtId               String?      @map("district_id") @db.Uuid
  churchId                 String?      @map("church_id") @db.Uuid
  departmentId             String?      @map("department_id") @db.Uuid
  actorType                String       @map("actor_type") @db.VarChar(20)
  actorUserAccountId       String?      @map("actor_user_account_id") @db.Uuid
  actorServicePrincipalId  String?      @map("actor_service_principal_id") @db.Uuid
  initiatingUserAccountId  String?      @map("initiating_user_account_id") @db.Uuid
  action                   String       @db.VarChar(100)
  targetType               String       @map("target_type") @db.VarChar(80)
  targetId                 String?      @map("target_id") @db.Uuid
  occurredAt               DateTime     @map("occurred_at") @db.Timestamptz(6)
  reason                   String?      @db.Text
  correlationId            String?      @map("correlation_id") @db.Uuid
  safeChangeSummary        Json?        @map("safe_change_summary") @db.JsonB
  actorUserAccount         UserAccount? @relation("AuditActor", fields: [actorUserAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_events_actor_user")
  initiatingUserAccount    UserAccount? @relation("AuditInitiator", fields: [initiatingUserAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_events_initiating_user")

  @@index([actorUserAccountId, occurredAt], map: "ix_audit_events_actor_user_time")
  @@index([targetType, targetId, occurredAt], map: "ix_audit_events_target_time")
  @@index([correlationId], map: "ix_audit_events_correlation")
  @@map("audit_events")
}

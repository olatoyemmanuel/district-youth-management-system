# Application environment
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection
DATABASE_URL="postgresql://dyms_user:CHANGE_ME@127.0.0.1:5432/dyms?schema=public"

# Global API rate limit
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Browser security. Use comma-separated exact origins, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Generate three independent secrets with: openssl rand -base64 48
# Do not reuse a secret for multiple purposes. Never commit real values.
AUTH_ACCESS_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_IDENTIFIER_HMAC_SECRET=REPLACE_WITH_A_THIRD_RANDOM_SECRET_AT_LEAST_32_CHARS

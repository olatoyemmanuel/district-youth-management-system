# Application environment
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection
# Replace CHANGE_ME with your local database password.
# Never commit the real .env file or its credentials.
DATABASE_URL="postgresql://dyms_user:CHANGE_ME@127.0.0.1:5432/dyms?schema=public"

# Global API rate limit
# Maximum requests allowed within the configured time window.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
